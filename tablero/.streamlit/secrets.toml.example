# Copie este archivo como secrets.toml (NO se sube al repositorio) y complete con la URL y la clave de la API.
# En CloudShell: cat ~/.gamepulse_api_url  (la clave está en ~/.gamepulse_api_key; cópiela sin pegarla en chats).
[api]
url = "https://XXXXXXXXXX.execute-api.us-east-1.amazonaws.com"
clave = "pegue-aqui-la-clave"
